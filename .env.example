# Health Monitor - variáveis de ambiente
#
# COPIE este arquivo para `apps/web/.env.local` antes de rodar o app.
# NUNCA commite o .env.local (o .gitignore já bloqueia).
#
# Cada variável abaixo é obrigatória salvo indicação contrária.

# URL pública do app (usada em links de compartilhamento e callbacks).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase ---------------------------------------------------------------------
# Em produção: https://<project-ref>.supabase.co
# Local (supabase start): http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=

# Chave "publishable" (antiga anon key). Pública por design; usada no browser
# e no servidor junto ao access token do usuário.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chave "secret" (antiga service_role). APENAS servidor. Bypassa RLS.
# Uso atual: página pública /view/[token] (leitura de compartilhamentos)
# e rotas administrativas internas.
SUPABASE_SERVICE_ROLE_KEY=

# Antrópic (visão: identificação de treino e medicação por foto) -------------
ANTHROPIC_API_KEY=

# Cron / jobs agendados ----------------------------------------------------------
# Segredo compartilhado entre o agendador externo (Supabase cron, Vercel cron,
# etc.) e as rotas /api/push/send e /api/oura/* protegidas.
# Gere com: openssl rand -hex 32
# Se ausente, as rotas de cron respondem 500 (fail-closed).
CRON_SECRET=

# Web Push (VAPID) ----------------------------------------------------------------
# Gere o par com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Deve ser idêntico a VAPID_PUBLIC_KEY (exposto ao browser).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Contato exigido pela especificação VAPID (formato mailto:).
VAPID_CONTACT_EMAIL=mailto:voce@exemplo.com
