{
  "name": "rafael-defendi-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.13.0",
  "workspaces": [
    "apps/web",
    "packages/shared",
    "packages/db"
  ],
  "scripts": {
    "dev": "npm run dev -w @rafael-defendi/web",
    "build": "npm run build -w @rafael-defendi/web",
    "lint": "npm run lint -w @rafael-defendi/web",
    "typecheck": "npm run typecheck -w @rafael-defendi/web && npm run typecheck -w @rafael-defendi/shared && npm run typecheck -w @rafael-defendi/db",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "npm run db:generate -w @rafael-defendi/db",
    "db:migrate": "npm run db:migrate -w @rafael-defendi/db",
    "db:studio": "npm run db:studio -w @rafael-defendi/db"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "typescript": "^5.6.3"
  }
}
