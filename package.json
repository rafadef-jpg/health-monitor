{
  "name": "health-monitor",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.13.0",
  "workspaces": [
    "apps/web",
    "packages/shared",
    "packages/physiology"
  ],
  "scripts": {
    "dev": "npm run dev -w @health-monitor/web",
    "build": "npm run build -w @health-monitor/web",
    "lint": "npm run lint -w @health-monitor/web",
    "typecheck": "npm run typecheck -w @health-monitor/web && npm run typecheck -w @health-monitor/shared",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "supabase": "^2.117.0",
    "typescript": "^5.6.3"
  }
}
